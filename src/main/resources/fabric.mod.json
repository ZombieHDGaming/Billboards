{
	"schemaVersion": 1,
	"id": "billboards",
	"version": "${version}",
	"name": "Billboards",
	"description": "Place and animate images, text and other overlays inside Flashback replays, in the world or on screen, and export them with the video.",
	"authors": [
		"ZombieHDGaming"
	],
	"contact": {
		"sources": "https://github.com/ZombieHDGaming/Billboards"
	},
	"license": "CC0-1.0",
	"icon": "assets/billboards/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"me.zhdg.billboards.BillboardsClient"
		]
	},
	"mixins": [
		{
			"config": "billboards.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*",
		"flashback": ">=0.43.6 <0.44"
	}
}
